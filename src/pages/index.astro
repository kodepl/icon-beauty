---
import { getCollection } from "astro:content";
import Shell from "../layouts/Shell.astro";
const posts = (await getCollection("ikony")).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const lead = posts[0];
const rest = posts.slice(1, 7);

const dzialy = [...new Set(posts.map((post) => post.data.category).filter(Boolean))].map((name) => ({
  name,
  slug: String(name).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/ł/g, "l").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
  count: posts.filter((post) => post.data.category === name).length,
}));
---
<Shell title="ICON | uroda z łazienki, nie z filtra" description="Redakcja ICON: skóra, makijaż, zapach i światło przy umywalce. Warszawa, Wilcza.">
  <section class="mx-auto grid max-w-6xl items-end gap-10 px-5 pb-10 pt-12 md:grid-cols-12">
    <div class="rise md:col-span-5">
      <p class="text-[11px] uppercase tracking-[0.32em] text-oxblood">Warszawa · Wilcza</p>
      <h1 class="mt-5 font-display text-6xl leading-[0.88] md:text-8xl">ICON</h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-[var(--mute)]">Uroda, którą widać bez filtra. Skóra, światło, zapach i makijaż opisane z łazienki.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/ikony/" class="bg-ink px-5 py-3 text-sm text-paper">Czytaj ikony</a>
        <a href="/lista-lazienki/" class="border border-ink/20 px-5 py-3 text-sm">Lista łazienki</a>
      </div>
    </div>
    <div class="rise rise-delay md:col-span-7">
      {lead && (
        <a href={`/ikony/${lead.slug}/`} class="group block">
          <img src={lead.data.image} alt="" class="h-[22rem] w-full object-cover md:h-[28rem]" width="1200" height="900" />
          <p class="mt-4 text-[11px] uppercase tracking-[0.22em] text-oxblood">{lead.data.category}</p>
          <h2 class="mt-1 font-display text-3xl leading-tight group-hover:underline md:text-4xl">{lead.data.title}</h2>
        </a>
      )}
    </div>
  </section>

  <section class="rise rise-delay-2 border-y border-[var(--line)] bg-[var(--paper-deep)]/40">
    <div class="mx-auto grid max-w-6xl gap-0 md:grid-cols-3">
      {rest.slice(0, 3).map((post) => (
        <a href={`/ikony/${post.slug}/`} class="border-b border-[var(--line)] p-6 md:border-b-0 md:border-r md:last:border-r-0">
          <p class="text-[11px] uppercase tracking-[0.18em] text-oxblood">{post.data.category}</p>
          <h3 class="mt-2 font-display text-2xl leading-tight">{post.data.title}</h3>
          <p class="mt-3 line-clamp-2 text-sm text-[var(--mute)]">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.22em] text-[var(--mute)]">Z archiwum</p>
        <h2 class="mt-1 font-display text-4xl">Kolejne teksty</h2>
      </div>
      <a class="text-sm underline-offset-2 hover:underline" href="/ikony/">Pełne archiwum</a>
    </div>
    <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {rest.slice(3).map((post) => (
        <a href={`/ikony/${post.slug}/`} class="group">
          <img src={post.data.image} alt="" class="aspect-[4/3] w-full object-cover" width="800" height="600" />
          <p class="mt-3 text-[11px] uppercase tracking-[0.18em] text-oxblood">{post.data.category}</p>
          <h3 class="mt-1 font-display text-2xl leading-tight group-hover:underline">{post.data.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.22em] text-[var(--mute)]">Działy</p>
        <h2 class="mt-1 font-display text-4xl">Tematy</h2>
      </div>
      <a class="text-sm underline-offset-2 hover:underline" href="/tematy/">Wszystkie działy</a>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      {dzialy.map((item) => (
        <a class="border border-[var(--line)] px-3 py-2 text-sm hover:border-oxblood/40 hover:text-oxblood" href={`/tematy/${item.slug}/`}>
          {item.name}
          <span class="ml-2 text-[var(--mute)]">{item.count}</span>
        </a>
      ))}
    </div>
  </section>
</Shell>
