---
import { getCollection } from "astro:content";
import Shell from "../layouts/Shell.astro";
const posts = (await getCollection("ikony")).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const lead = posts[0];
const rest = posts.slice(1, 9);
---
<Shell title="ICON | uroda bez filtra" description="Redakcja urody ICON: skóra, makijaż, zapach i światło w łazience. Warszawa.">
  <section class="mx-auto grid max-w-6xl items-end gap-8 px-5 pb-8 pt-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="text-xs uppercase tracking-[0.32em] text-[#9a6a58]">Warszawa · Wilcza</p>
      <h1 class="mt-4 font-display text-7xl leading-[0.85] md:text-8xl">Uroda,<br/>którą widać<br/>bez filtra.</h1>
    </div>
    <div class="md:col-span-7">
      {lead && (
        <a href={`/ikony/${lead.slug}/`} class="group block">
          <img src={lead.data.image} alt="" class="h-[26rem] w-full object-cover" />
          <p class="mt-4 text-xs uppercase tracking-[0.22em] text-[#9a6a58]">{lead.data.category}</p>
          <h2 class="mt-1 font-display text-4xl group-hover:underline">{lead.data.title}</h2>
        </a>
      )}
    </div>
  </section>
  <section class="mx-auto grid max-w-6xl gap-px bg-[#241814]/10 px-5 sm:grid-cols-2 lg:grid-cols-4">
    {rest.map((post) => (
      <a href={`/ikony/${post.slug}/`} class="bg-[#f4efe8] p-4">
        <img src={post.data.image} alt="" class="h-44 w-full object-cover" />
        <p class="mt-3 text-[11px] uppercase tracking-[0.18em] text-[#9a6a58]">{post.data.category}</p>
        <h3 class="mt-1 font-display text-2xl leading-tight">{post.data.title}</h3>
      </a>
    ))}
  </section>
</Shell>
