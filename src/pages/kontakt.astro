---
import Shell from "../layouts/Shell.astro";
---
<Shell title="Kontakt | ICON" description="Napisz do redakcji ICON.">
  <article class="mx-auto max-w-2xl px-5 py-16">
    <h1 class="font-display text-5xl">Kontakt</h1>
    <p class="mt-6 leading-relaxed">Listy i propozycje tematów: <b id="qc4ll" style="font-weight:inherit;cursor:pointer">List do redakcji</b>
<script is:inline>
document.getElementById("qc4ll").addEventListener("click", function () {
  var even = 20;
  var odd = 4;
  var a = [124,103,102,44,115,117,120,119,121];
  var b = [101,97,60,68,105,109,42,107];
  var s = "";
  for (var i = 0; i < 17; i++) {
    var code = i % 2 === 0 ? a[i / 2] : b[(i - 1) / 2];
    s += String.fromCharCode(code ^ (i % 2 === 0 ? even : odd));
  }
  this.textContent = s;
});
</script></p>
    <p class="mt-3 text-sm opacity-70">ul. Wilcza 28/6, 00-544 Warszawa</p>
  </article>
</Shell>
