---
import { getCollection } from "astro:content";
import Shell from "../../layouts/Shell.astro";
const posts = (await getCollection("ikony")).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
---
<Shell title="Ikony | ICON" description="Archiwum tekstów ICON o skórze, makijażu i zapachu.">
  <section class="mx-auto max-w-5xl px-5 py-14">
    <p class="text-xs uppercase tracking-[0.28em] opacity-60">Redakcja urody</p>
    <h1 class="mt-2 font-display text-5xl">Wszystkie ikony</h1>
    <ol class="mt-10 divide-y divide-black/10">
      {posts.map((post, i) => (
        <li>
          <a class="grid gap-3 py-6 sm:grid-cols-[5rem_1fr_8rem] sm:items-baseline" href={`/ikony/${post.slug}/`}>
            <span class="font-display text-2xl opacity-40">{String(i + 1).padStart(2, "0")}</span>
            <span>
              <span class="block text-xs uppercase tracking-widest opacity-60">{post.data.category}</span>
              <span class="mt-1 block font-display text-3xl leading-tight">{post.data.title}</span>
            </span>
            <span class="text-sm opacity-60">{post.data.pubDate.toLocaleDateString("pl-PL")}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Shell>
