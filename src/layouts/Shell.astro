---
import "../styles/global.css";
const {
  title,
  description,
  image = "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=1200&h=630&q=80",
  type = "website",
} = Astro.props;
const path = Astro.url.pathname;
const canonical = `https://www.iconbeauty.pl${path}`;
const nav = [
  { href: "/ikony/", label: "Ikony" },
  { href: "/tematy/", label: "Tematy" },
  { href: "/lista-lazienki/", label: "Lista" },
  { href: "/w-lazience/", label: "Szukaj" },
  { href: "/o-nas/", label: "Redakcja" },
  { href: "/kontakt/", label: "List" },
];
function isCurrent(href) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href);
}
---
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="ICON" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,650&family=Figtree:wght@400;520;600&display=swap" rel="stylesheet" />
    <script is:inline>if(location.hostname==="iconbeauty.pl")location.replace(location.href.replace("://","://www."));</script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "ICON",
      url: "https://www.iconbeauty.pl/",
      description: "Redakcja urody: skóra, światło w łazience, makijaż i zapach bez filtra z rolki.",
      inLanguage: "pl-PL",
      publisher: {
        "@type": "Organization",
        name: "ICON",
        url: "https://www.iconbeauty.pl/",
        address: {
          "@type": "PostalAddress",
          streetAddress: "ul. Wilcza 28/6",
          addressLocality: "Warszawa",
          postalCode: "00-544",
          addressCountry: "PL",
        },
      },
    })} />
  </head>
  <body class="font-sans antialiased text-ink">
    <a href="#tresc" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-3 focus:py-2">Przejdź do treści</a>
    <header class="border-b border-[var(--line)]">
      <div class="mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-4 px-5 pb-5 pt-7">
        <a href="/" class="group">
          <span class="font-display text-5xl leading-none tracking-tight md:text-6xl">ICON</span>
          <span class="mt-1 block text-[11px] uppercase tracking-[0.28em] text-[var(--mute)]">Uroda z łazienki · Warszawa</span>
        </a>
        <nav class="site-nav flex flex-wrap gap-x-5 gap-y-2 pb-1 text-[11px] uppercase tracking-[0.2em] text-[var(--mute)]" aria-label="Główne">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined} class="hover:text-oxblood">{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="tresc">
      <slot />
    </main>
    <footer class="mt-20 border-t border-[var(--line)] bg-[var(--paper-deep)]/55">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <p class="font-display text-3xl">ICON</p>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-[var(--mute)]">Skóra, światło, zapach i makijaż opisane z łazienki, nie z reklamy. Bez obietnicy, że jeden słoik zmieni twarz.</p>
        </div>
        <div class="text-sm">
          <p class="text-[11px] uppercase tracking-[0.2em] text-[var(--mute)]">Czytaj</p>
          <div class="mt-3 flex flex-col gap-2">
            <a href="/ikony/">Archiwum ikon</a>
            <a href="/tematy/">Tematy</a>
            <a href="/lista-lazienki/">Lista łazienki</a>
            <a href="/w-lazience/">Szukaj</a>
          </div>
        </div>
        <div class="text-sm">
          <p class="text-[11px] uppercase tracking-[0.2em] text-[var(--mute)]">Redakcja</p>
          <div class="mt-3 flex flex-col gap-2">
            <a href="/o-nas/">O nas</a>
            <a href="/kontakt/">Kontakt</a>
            <a href="/polityka-prywatnosci/">Prywatność</a>
          </div>
        </div>
      </div>
      <div class="border-t border-[var(--line)]">
        <p class="mx-auto max-w-6xl px-5 py-4 text-xs text-[var(--mute)]">© {new Date().getFullYear()} ICON · ul. Wilcza 28/6, 00-544 Warszawa</p>
      </div>
    </footer>
    <div id="pasek-icon-beauty" style="position:fixed;top:0;left:0;height:3px;width:0;background:#6b2d3c;z-index:40;pointer-events:none" aria-hidden="true"></div>
    <script>
      const pasek = document.getElementById("pasek-icon-beauty");
      addEventListener("scroll", () => {
        const node = document.documentElement;
        const max = node.scrollHeight - node.clientHeight;
        pasek.style.width = (max > 0 ? (node.scrollTop / max) * 100 : 0) + "%";
      }, { passive: true });
    </script>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"bf14b26c69ae457184d12010df9a5de0"}'></script>
    <script defer src="https://umami-pink-phi.vercel.app/script.js" data-website-id="db473681-4dce-495c-bf0f-c72c9c9abfe8" data-domains="iconbeauty.pl,www.iconbeauty.pl"></script>
  </body>
</html>
